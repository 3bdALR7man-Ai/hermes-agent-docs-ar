["<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes plugins </span><span class=\"token builtin class-name\" style=\"color:rgb(189, 147, 249)\">enable</span><span class=\"token plain\"> disk-cleanup</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-yaml codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token key atrule\">plugins</span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">:</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">  </span><span class=\"token key atrule\">enabled</span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">:</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">    </span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">-</span><span class=\"token plain\"> disk</span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">-</span><span class=\"token plain\">cleanup</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes plugins disable disk-cleanup</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># or: remove it from plugins.enabled in config.yaml</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">/disk-cleanup status                     # breakdown + top-10 largest</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">/disk-cleanup dry-run                    # preview without deleting</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">/disk-cleanup quick                      # run safe cleanup now</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">/disk-cleanup deep                       # quick + list items needing confirmation</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">/disk-cleanup track &lt;path&gt; &lt;category&gt;    # manual tracking</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">/disk-cleanup forget &lt;path&gt;              # stop tracking (does not delete)</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes tools          </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># → Langfuse Observability → Cloud or Self-Hosted</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">pip </span><span class=\"token function\" style=\"color:rgb(80, 250, 123)\">install</span><span class=\"token plain\"> langfuse</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes plugins </span><span class=\"token builtin class-name\" style=\"color:rgb(189, 147, 249)\">enable</span><span class=\"token plain\"> observability/langfuse</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token assign-left variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">HERMES_LANGFUSE_PUBLIC_KEY</span><span class=\"token operator\">=</span><span class=\"token plain\">pk-lf-</span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">..</span><span class=\"token plain\">.</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token assign-left variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">HERMES_LANGFUSE_SECRET_KEY</span><span class=\"token operator\">=</span><span class=\"token plain\">sk-lf-</span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">..</span><span class=\"token plain\">.</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token assign-left variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">HERMES_LANGFUSE_BASE_URL</span><span class=\"token operator\">=</span><span class=\"token plain\">https://cloud.langfuse.com   </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># or your self-hosted URL</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes plugins list                 </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># observability/langfuse should show &quot;enabled&quot;</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes chat </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">-q</span><span class=\"token plain\"> </span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">&quot;hello&quot;</span><span class=\"token plain\">              </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># check the Langfuse UI for a &quot;Hermes turn&quot; trace</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-yaml codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token key atrule\">gateway</span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">:</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">  </span><span class=\"token key atrule\">telemetry</span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">:</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">    </span><span class=\"token key atrule\">session_segments</span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">:</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">      </span><span class=\"token key atrule\">on_compaction</span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">:</span><span class=\"token plain\"> </span><span class=\"token boolean important\">false</span><span class=\"token plain\">  </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># rotate after context compaction</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">      </span><span class=\"token key atrule\">max_turns</span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">:</span><span class=\"token plain\"> </span><span class=\"token number\">0</span><span class=\"token plain\">          </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># 0 = unlimited; N = turns per segment</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes plugins </span><span class=\"token builtin class-name\" style=\"color:rgb(189, 147, 249)\">enable</span><span class=\"token plain\"> google_meet</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes meet setup   </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># preflight: playwright, chromium, auth file</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes meet auth    </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># opens a browser to sign into Google and saves session state —</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">                    </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># needs a Google account with Meet access. Host approval may be</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">                    </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># required if the meeting enforces &quot;only invited participants can join&quot;.</span><br></div></code></pre>"]