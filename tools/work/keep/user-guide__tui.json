["<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># Launch the TUI</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--tui</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\" style=\"display:inline-block\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># Resume the latest TUI session (falls back to the latest classic session)</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--tui</span><span class=\"token plain\"> </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">-c</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--tui</span><span class=\"token plain\"> </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--continue</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--tui</span><span class=\"token plain\"> </s