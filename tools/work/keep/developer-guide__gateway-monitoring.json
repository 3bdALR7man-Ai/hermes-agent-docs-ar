mes_cron_scheduler_catch_up_occurrences[15m]) &gt; 0</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes.status = failed|unknown</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes.delivery_outcome = failed|not_configured</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes.error_class = auth_failed|rate_limited|timeout|network_error|</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">                     dispatch_failed|interrupted|empty_response|</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">                     invalid_config|unknown</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># terminal 1: capture collector on :4318</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">python scripts/observability/otel_capture_collector.py </span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">\\</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">  </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--host</span><span class=\"token plain\"> </span><span class=\"token number\">127.0</span><span class=\"token plain\">.0.1 </span><span class=\"token parameter variable\" style=\"col