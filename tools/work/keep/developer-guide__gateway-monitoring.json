\" style=\"color:rgb(189, 147, 249);font-style:italic\">--wait</span><span class=\"token plain\"> </span><span class=\"token number\">8</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># exit 0 prints: {&quot;requests&quot;: 6, &quot;paths&quot;: [&quot;/v1/logs&quot;, &quot;/v1/metrics&quot;, &quot;/v1/traces&quot;]}</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes monitoring status                 </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># posture</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">python scripts/observability/gateway_health_export_probe.py </span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">\\</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">  </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--endpoint</span><span class=\"token plain\"> http://127.0.0.1:4318/v1/traces </span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">\\</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">  </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--log</span><span class=\"token plain\"> ~/.hermes/cache/scratch/cap.jsonl </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--wait</span><span class=\"token plain\"> </span><span class=\