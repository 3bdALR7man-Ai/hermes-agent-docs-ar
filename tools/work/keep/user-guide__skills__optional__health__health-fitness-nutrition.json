nt(f</span><span class=\"token string entity\" style=\"color:rgb(255, 121, 198)\">\\&quot;</span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">Primary   : {&#x27;, &#x27;.join(m.get(&#x27;name_en&#x27;,&#x27;&#x27;) for m in data.get(&#x27;muscles&#x27;,[])) or &#x27;N/A&#x27;}</span><span class=\"token string entity\" style=\"color:rgb(255, 121, 198)\">\\&quot;</span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">print(f</span><span class=\"token string entity\" style=\"color:rgb(255, 121, 198)\">\\&quot;</span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">Secondary : {&#x27;, &#x27;.join(m.get(&#x27;name_en&#x27;,&#x27;&#x27;) for m in data.get(&#x27;muscles_secondary&#x27;,[])) or &#x27;none&#x27;}</span><span class=\"token string entity\" style=\"color:rgb(255, 121, 198)\">\\&quot;</span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">print(f</span><span class=\"token string entity\" style=\"color:rgb(255, 121, 198)\">\\&quot;</span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">Equipment : {&#x27;, &#x27;.join(e.get(&#x27;name&#x27;,&#x27;&#x27;) for e in data.get(&#x27;equipment&#x27;,[])) or &#x27;bodyweight&#x27;}</span><span class=\"token string entity\" style=\"color:rgb(255, 121, 198)\">\\&quot;</span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">print(f</span><span class=\"token string entity\" style=\"color:rgb(255, 121, 198)\">\\&quot;</span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">How to    : {desc[:500]}</span><span class=\"token string 