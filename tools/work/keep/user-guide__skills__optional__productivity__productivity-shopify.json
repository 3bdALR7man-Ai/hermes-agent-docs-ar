an><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">shop_gql </span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">&#x27;</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">mutation($input: CustomerInput!) {</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">  customerCreate(input: $input) {</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    customer { id email }</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    userErrors { field message }</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">  }</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">}&#x27;</span><span class=\"token plain\"> </span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">&#x27;{&quot;input&quot;:{&quot;email&quot;:&quot;test@example.com&quot;,&quot;firstName&quot;:&quot;Test&quot;,&quot;lastName&quot;:&quot;User&quot;,&quot;tags&quot;:[&quot;api-created&quot;]}}&#x27;</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># Get inventory for a variant across all locations</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">shop_gql </span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">&#x27;</span><br></