["<pre tabindex=\"0\" class=\"prism-code language-powershell codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">wsl --install</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-powershell codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">wsl --list --verbose</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-powershell codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">wsl --set-version Ubuntu 2</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">wsl --set-default-version 2</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token function\" style=\"color:rgb(80, 250, 123)\">sudo</span><span class=\"token plain\"> </span><span class=\"token function\" style=\"color:rgb(80, 250, 123)\">tee</span><span class=\"token plain\"> /etc/wsl.conf </span><span class=\"token operator\">&gt;</span><span class=\"token plain\">/dev/null </span><span class=\"token operator\">&lt;&lt;</span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">&#x27;EOF&#x27;</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">[boot]</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">systemd=true</span>