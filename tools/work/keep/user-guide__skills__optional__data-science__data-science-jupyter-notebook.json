["<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">SCRIPT=&quot;$HOME/.agent-skills/hamelnb/skills/jupyter-live-kernel/scripts/jupyter_live_kernel.py&quot;</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">git clone https://github.com/hamelsmu/hamelnb.git ~/.agent-skills/hamelnb</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">uv run &quot;$SCRIPT&quot; servers</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">jupyter-lab --no-browser --port=8888 --notebook-dir=$HOME/notebooks \\</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">  --IdentityProvider.token=&#x27;&#x27; --ServerApp.password=&#x27;&#x27; &gt; /tmp/jupyter.log 2&gt;&amp;1 &amp;</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">sleep 3</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">mkdir -p ~/notebooks</span><br></di