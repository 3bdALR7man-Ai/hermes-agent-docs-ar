["<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">{output_dir}/</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">├── screenshots/       # Evidence screenshots</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">└── report.md          # Final report (generated in Phase 5)</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-python codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># Open page with console-error capture</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">HOOK </span><span class=\"token operator\">=</span><span class=\"token plain\"> </span><span class=\"token triple-quoted-string string\" style=\"color:rgb(255, 121, 198)\">&quot;&quot;&quot;window.__qa_errors = [];</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token triple-quoted-string string\" style=\"color:rgb(255, 121, 198)\">const _e = console.error;</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token triple-quoted-string string\" style=\"color:rgb(255, 121, 198)\">console.error = (...a) =&gt; { window.__qa_errors.push(a.map(String).join(&#x27; &#x27;)); _e(...a); };</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token triple-quoted-string string\" style=\"color:rgb(255, 121, 198)\">addEventListener(&#x27;error&#x27;, e =&gt; window.__qa_errors.push(&#x27;uncaught: &#x27; + e.message));</span><br></div><div class=\"token-line\" style=\"c