F2\"><span class=\"token plain\"></span><span class=\"token assign-left variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">EMAIL_HOME_ADDRESS</span><span class=\"token operator\">=</span><span class=\"token plain\">your@email.com      </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># Default delivery target for cron jobs</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes gateway              </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># Run in foreground</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes gateway </span><span class=\"token function\" style=\"color:rgb(80, 250, 123)\">install</span><span class=\"token plain\">      </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># Install as a user service</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token function\" style=\"color:rgb(80, 250, 123)\">sudo</span><span class=\"token plain\"> hermes gateway </span><span class=\"token function\" style=\"color:rgb(80, 250, 123)\">install</span><span class=\"token plain\"> </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--system</span><span class=\"token plain\">   </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># Linux only: boot-time system service</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-yaml codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"