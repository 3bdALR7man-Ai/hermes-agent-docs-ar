in\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\" style=\"display:inline-block\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># Check for new config options</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes config check</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes config migrate   </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># Interactively add any missing options</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token builtin class-name\" style=\"color:rgb(189, 147, 249)\">cd</span><span class=\"token plain\"> /path/to/hermes-agent</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\" style=\"display:inline-block\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># List recent versions</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token function\" style=\"color:rgb(80, 250, 123)\">git</span><span class=\"token plain\"> log </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--oneline</span><span class=\"token plain\"> </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">-10</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F