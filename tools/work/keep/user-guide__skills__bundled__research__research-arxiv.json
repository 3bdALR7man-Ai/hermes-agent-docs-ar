198)\">)},&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">print(f&#x27;  title     = {{{title}}},&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">print(f&#x27;  author    = {{{authors}}},&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">print(f&#x27;  year      = {{{year}}},&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">print(f&#x27;  eprint    = {{{raw_id}}},&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">print(f&#x27;  archivePrefix = {{arXiv}},&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">print(f&#x27;  primaryClass  = {{{primary}}},&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">print(f&#x27;  url       = {{https://arxiv.org/abs/{raw_id}}}&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">print(&#x27;}&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">&quot;</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"># Abstract page (fast, metadata + abstract)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">web_e