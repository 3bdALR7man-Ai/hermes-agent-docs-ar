 198)\">ns = {&#x27;a&#x27;: &#x27;http://www.w3.org/2005/Atom&#x27;}</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">root = ET.parse(sys.stdin).getroot()</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">for i, entry in enumerate(root.findall(&#x27;a:entry&#x27;, ns)):</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    title = entry.find(&#x27;a:title&#x27;, ns).text.strip().replace(&#x27;</span><span class=\"token string entity\" style=\"color:rgb(255, 121, 198)\">\\n</span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">&#x27;, &#x27; &#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    arxiv_id = entry.find(&#x27;a:id&#x27;, ns).text.strip().split(&#x27;/abs/&#x27;)[-1]</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    published = entry.find(&#x27;a:published&#x27;, ns).text[:10]</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    authors = &#x27;, &#x27;.join(a.find(&#x27;a:name&#x27;, ns).text for a in entry.findall(&#x27;a:author&#x27;, ns))</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    summary = entry.find(&#x27;a:summary&#x27;, ns).text.strip()[:200]</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    cats = &#x27;, &#x27;.join(c.get(&#x27;term&#x27;) for c in entry.findall(&#x27;a:category&#x27;, ns))</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    print(f&#x27;{i+1}. [{arxiv_id}] {title}&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    print(f&#x27;   Authors: {authors}&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    print(f&#x27;   Published: {published} | Categories: {cats}&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    print(f&#x27;   Abstract: {summary}...&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    print(f&#x27;   PDF: https://arxiv.org/pdf/{arxiv_id}&#x27;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">    print()</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">&quot;</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"># AND (default when using +)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">search_query=all:transformer+attention</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\" style=\"display:inline-block\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"># OR</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">search_query=all:GPT+OR+all:BERT</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span clas