98, 114, 164)\"># Zsh</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token builtin class-name\" style=\"color:rgb(189, 147, 249)\">eval</span><span class=\"token plain\"> </span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">&quot;</span><span class=\"token string variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">$(</span><span class=\"token string variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">hermes completion </span><span class=\"token string variable function\" style=\"color:rgb(80, 250, 123);font-style:italic\">zsh</span><span class=\"token string variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">)</span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">&quot;</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># In chat, run /export, hand over the file, and they run /import on it</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes profile </span><span class=\"token builtin class-name\" style=\"color:rgb(189, 147, 249)\">export</span><span class=\"token plain\"> coder</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes profile </span><span class=\"token function\" style=\"color:rgb(80, 250, 123)\">import</span><span class=\"token plain\"> ./coder.tar.gz </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--name</span><span class=\"token plain\"> coder</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9