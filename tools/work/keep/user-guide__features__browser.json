n string environment constant\" style=\"color:rgb(189, 147, 249)\">$HOME</span><span class=\"token string\" style=\"color:rgb(255, 121, 198)\">/.hermes/chrome-debug&quot;</span><span class=\"token plain\"> </span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">\\</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">  --no-first-run </span><span class=\"token punctuation\" style=\"color:rgb(248, 248, 242)\">\\</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">  --no-default-browser-check </span><span class=\"token operator\">&amp;</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"># List tabs (browser-level, no target_id)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">browser_cdp(method=&quot;Target.getTargets&quot;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\" style=\"display:inline-block\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"># Handle a native JS dialog on a tab</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">browser_cdp(method=&quot;Page.handleJavaScriptDialog&quot;,</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">            params={&quot;accept&quot;: true, &quot;promptText&quot;: &quot;&quot;},</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">            target_id=&quot;&lt;tabId&gt;&quot;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\" style=\"display:inline-block\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"># Evaluate JS in a specific tab</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">browser_cdp(method=&quot;Runtime.evaluate&quot;,</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">            params={&quot;expression&quot;: &quot;document.title&quot;, &quot;returnByValue&quot;: true},</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">            target_id=&quot;&lt;tabId&gt;&quot;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\" style=\"display:inline-block\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"># Get all cookies</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">browser_cdp(method=&quot;Network.getAllCookies&quot;)</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes tools disable browser                      </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># CLI</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">hermes tools disable browser </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--platform</span><span class=\"token plain\"> telegram  </span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># one gateway platform</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">User: Sign up for an account on example.com with my email john@example.com</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\" style=\"display:inline-block\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">Agent: browser_exec(code=&quot;&quot;&quot;</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"># Opening the signup form</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">new_tab(&quot;https://example.com/signup&quot;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">wait_for_load()</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">fill_input(&quot;input[name=email]&quot;, &quot;john@example.com&quot;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">js(&quot;document.querySelector(&#x27;button[type=submit]&#x27;).click()&quot;)</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">wait_for_load()</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">print(page_info())</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">&quot;&quot;&quot;)</span><br></div></code></pre>","<pre tabindex=\"0\" class=\"prism-code language-text codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">User: What are the top trending repos on GitHub right now?</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\" style=\"display:inline-block\"></span><br></div>