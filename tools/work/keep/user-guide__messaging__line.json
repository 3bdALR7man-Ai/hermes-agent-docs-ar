["<pre tabindex=\"0\" class=\"prism-code language-bash codeBlock_bY9V thin-scrollbar\" style=\"color:#F8F8F2;background-color:#282A36\"><code class=\"codeBlockLines_e6Vv\"><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># Cloudflare Tunnel (recommended for production — fixed hostname)</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">cloudflared tunnel </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">--url</span><span class=\"token plain\"> http://localhost:8646</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\" style=\"display:inline-block\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># ngrok (good for dev)</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">ngrok http </span><span class=\"token number\">8646</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\" style=\"display:inline-block\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\"></span><span class=\"token comment\" style=\"color:rgb(98, 114, 164)\"># devtunnel</span><span class=\"token plain\"></span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">devtunnel create hermes-line --allow-anonymous</span><br></div><div class=\"token-line\" style=\"color:#F8F8F2\"><span class=\"token plain\">devtunnel port create hermes-line </span><span class=\"token parameter variable\" style=\"color:rgb(189, 147, 249);font-style:italic\">-p</span><span class=\"token plain\"> </span><span class=\"token number\">8646</span><span class=\